#!/usr/bin/env bash
# pre-push — hard rule (never-do layer): no secrets/internal IPs leave this
# repo. Enforced at the tool level, not by convention or memory.
#
# Scans the commits being pushed (not the working tree — gitignored local
# files like runtime.conf/.env are fine to keep locally, just not to push).
#
# Install: git config core.hooksPath scripts/githooks   (done in this repo)
# See also: pre-commit (same checks, staged diff only)
# Config:  ~/data/benchmark/config/gitleaks.toml — if missing, falls back
#          to gitleaks default rules (weaker: no internal-IP/domain rules).

set -u
GITLEAKS_CONFIG="$HOME/data/benchmark/config/gitleaks.toml"

cmd=(gitleaks git --redact)
if [ -f "$GITLEAKS_CONFIG" ]; then
    cmd+=(-c "$GITLEAKS_CONFIG")
else
    echo "pre-push: WARN custom gitleaks config not found ($GITLEAKS_CONFIG) — using default rules (no internal-IP/domain checks)" >&2
fi
cmd+=(.)

# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
# remote_sha all-zeros = new branch → scan everything not already on a remote.
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_sha" =~ ^0+$ ]]; then
        log_opts="$local_sha --not --remotes --first-parent"
    else
        log_opts="$remote_sha..$local_sha"
    fi
    # Distinguish scan-failure from leak-found: a missing remote_sha object
    # (e.g. after local gc) makes git log fail inside gitleaks, which is NOT
    # a leak — refetch and retry instead of blocking the push forever.
    if ! out=$("${cmd[@]}" --log-opts="$log_opts" 2>&1); then
        if printf '%s' "$out" | grep -q "leaks found"; then
            printf '%s\n' "$out" >&2
            echo "pre-push: BLOCKED — gitleaks found issues in $local_ref ($log_opts). Remove them (git rebase/filter) and push again." >&2
            fail=1
        else
            echo "pre-push: WARN gitleaks scan failed (not a leak finding) for $local_ref — attempting fetch + retry" >&2
            git fetch --quiet origin 2>/dev/null || true
            if ! out=$("${cmd[@]}" --log-opts="$log_opts" 2>&1); then
                printf '%s\n' "$out" >&2
                echo "pre-push: BLOCKED — gitleaks scan errored twice for $local_ref ($log_opts). Investigate manually (gitleaks git --log-opts='$log_opts')." >&2
                fail=1
            fi
        fi
    fi
done

exit "$fail"

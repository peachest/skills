{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L5 Page (section composition)",
  "type": "object",
  "required": ["name", "scene", "sections"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "scene": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string"},
          "required": {"type": "boolean"},
          "position": {"enum": ["first", "last"]},
          "max_items": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

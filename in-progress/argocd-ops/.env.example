# argocd-ops environment binding
# Copy to .env and fill per cluster. Never commit .env.
#
# argocd-server Service host:port (kubectl get svc argocd-server -n <ns>)
ARGOCD_SERVER=
# true  — server serves plaintext (http, typically port 80)
# false — TLS (self-signed cert: use --insecure flag on login anyway when
#         the cert has no IP SANs for ARGOCD_SERVER)
ARGOCD_INSECURE=
# true — behind a load balancer that requires gRPC-web
ARGOCD_GRPC_WEB=
ARGOCD_USERNAME=admin
# Real password from the cluster operator. NOTE: the
# argocd-initial-admin-secret often holds a STALE value (password rotated
# after install via UI changes nothing in that secret).
ARGOCD_PASSWORD=
# kubectl invocation; embed sudo when the kubeconfig needs it,
# e.g. "sudo /usr/bin/kubectl" or "/usr/local/bin/kubectl"
# NOTE: quote values that contain spaces — .env is sourced by a shell
KUBECTL=
# namespace ArgoCD itself runs in
ARGOCD_NS=argocd
# argocd binary (nix: ~/.nix-profile/bin/argocd; brew: /opt/homebrew/bin/argocd)
ARGOCD_BIN=argocd

# runtime.conf.example — copy to runtime.conf and adjust per node.
# runtime.conf is gitignored; only this template is tracked.

# Path to the dedicated weasyprint venv. The export script prepends
# <WEASYPRINT_VENV>/bin to PATH so pandoc's --pdf-engine=weasyprint resolves.
# It also holds pymupdf (optional, for page counts).
# Discovery: if `command -v weasyprint` already works globally, leave the
# default (venv is only a fallback). Otherwise create it:
#   uv venv ~/.venvs/weasyprint
#   uv pip install --python ~/.venvs/weasyprint/bin/python weasyprint pymupdf
WEASYPRINT_VENV=~/.venvs/weasyprint

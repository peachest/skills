# html-render-check runtime configuration
# Copy to runtime.conf and adjust per-node values. Shell-sourceable dotenv.

# Directory containing node_modules/playwright (the skill repo is public and
# cannot ship node_modules). Setup:
#   mkdir -p ~/tools/playwright-runner && cd ~/tools/playwright-runner && npm init -y && npm install playwright
# (npm install needs the network; on the internal cluster use the corporate proxy.)
PLAYWRIGHT_DIR=$HOME/tools/playwright-runner

# Chromium binaries are shared via Playwright's default cache (~/.cache/ms-playwright).
# Install with: cd $PLAYWRIGHT_DIR && npx playwright install chromium --only-shell
# System libs needed (Debian/Ubuntu): sudo apt install libgbm1 libxkbcommon0
# Cluster/container nodes launch with --no-sandbox by default; set PW_SANDBOX=1 to allow it.
